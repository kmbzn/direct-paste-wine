def capture_screenshot(mode="area"):
    temp_path = os.path.join(GLib.get_user_cache_dir(), "direct_paste_temp.png")
    
    # Pre-clean stale temp screenshot file to ensure a new capture is verified
    if os.path.exists(temp_path):
        try:
            os.remove(temp_path)
        except Exception:
            pass

    cmd = ["gnome-screenshot"]
    if mode == "area":
        cmd.append("-a")
    elif mode == "window":
        cmd.append("-w")
    cmd.extend(["-f", temp_path])
        
    try:
        res_run = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res_run.returncode == 0 and os.path.exists(temp_path):
            return temp_path
    except Exception as e:
        print(f"gnome-screenshot execution failed: {e}", file=sys.stderr)
        
    return None

def gsettings_key_exists(schema, key):
    res = subprocess.run(['gsettings', 'range', schema, key], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    return res.returncode == 0

# ----------------------------------------------------------------------
# GSettings Keyboard Shortcut Mappings Scanner
# ----------------------------------------------------------------------

def get_current_shortcut_mappings():
    mappings = {
        'Print': ('disabled', 'both'),
        '<Ctrl>Print': ('disabled', 'both'),
        '<Shift>Print': ('disabled', 'both'),
        '<Alt>Print': ('disabled', 'both')
    }
    if shutil.which("gsettings") is None:
        return mappings

    try:
        res = subprocess.run(
            ['gsettings', 'get', 'org.gnome.settings-daemon.plugins.media-keys', 'custom-keybindings'],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
        )
        current = res.stdout.strip()
        if not current or current == "@as []":
            return mappings

        bindings_list = current.replace('[', '').replace(']', '').replace("'", "").split(', ')
        bindings_list = [b for b in bindings_list if b]

        schema = "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding"
        for path in bindings_list:
            res_bind = subprocess.run(
                ['gsettings', 'get', f"{schema}:{path}", 'binding'],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
            )
            binding_val = res_bind.stdout.strip().replace("'", "")
            
            res_cmd = subprocess.run(
                ['gsettings', 'get', f"{schema}:{path}", 'command'],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
            )
            command_val = res_cmd.stdout.strip().replace("'", "")

            if binding_val in mappings:
                words = command_val.split()
                # Check for the executable name as a substring of any word (e.g. path/to/direct-screenshot)
                if any("direct-screenshot" in w for w in words):
                    mode = 'area'
                    if "-s" in words or "--screen" in words:
                        mode = 'screen'
                    elif "-w" in words or "--window" in words:
                        mode = 'window'
                    
                    action = 'both'
                    if "--no-clipboard" in words:
                        action = 'save'
                    elif "--no-save" in words:
                        action = 'clipboard'

                    mappings[binding_val] = (mode, action)
    except Exception as e:
        print(f"Error scanning GSettings shortcuts: {e}", file=sys.stderr)

    return mappings

