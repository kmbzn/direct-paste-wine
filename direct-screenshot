# ----------------------------------------------------------------------
# Settings Persistence Helper Functions
# ----------------------------------------------------------------------

def load_settings():
    settings_path = os.path.expanduser("~/.config/direct-screenshot/settings.json")
    defaults = {
        'save_dir': os.path.expanduser("~/Pictures/Screenshots"),
        'save_enabled': True,
        'clipboard_enabled': True
    }
    if not os.path.exists(settings_path):
        return defaults
    try:
        with open(settings_path, "r") as f:
            data = json.load(f)
            for k, v in defaults.items():
                if k not in data:
                    data[k] = v
            return data
    except Exception:
        return defaults

def save_settings(data):
    settings_path = os.path.expanduser("~/.config/direct-screenshot/settings.json")
    try:
        os.makedirs(os.path.dirname(settings_path), exist_ok=True)
        with open(settings_path, "w") as f:
            json.dump(data, f)
    except Exception as e:
        print(f"Failed to save settings: {e}", file=sys.stderr)

# ----------------------------------------------------------------------
# Core Clipboard & OS Helper Functions
# ----------------------------------------------------------------------

def is_copyq_installed():
    return shutil.which("copyq") is not None

def is_gnome_screenshot_installed():
    return shutil.which("gnome-screenshot") is not None

def is_copyq_running():
    try:
        res = subprocess.run(['pgrep', '-x', 'copyq'], stdout=subprocess.DEVNULL)
        return res.returncode == 0
    except Exception:
        return False

def inject_to_clipboard(file_path):
    if not is_copyq_running():
        env = os.environ.copy()
        env["QT_QPA_PLATFORM"] = "xcb"
        try:
            subprocess.Popen(["copyq"], env=env)
            subprocess.run(["sleep", "0.5"])
        except Exception as e:
            print(f"Failed to launch CopyQ: {e}", file=sys.stderr)

    try:
        with open(file_path, "rb") as f:
            img_data = f.read()
        
        subprocess.run(
            ["copyq", "copy", "image/png", "-"],
            input=img_data,
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE
        )
        return True
    except Exception as e:
        print(f"Error copying image to CopyQ: {e}", file=sys.stderr)
        return False

def send_notification(summary, body):
    try:
        connection = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        proxy = Gio.DBusProxy.new_sync(
            connection,
            Gio.DBusProxyFlags.NONE,
            None,
            'org.freedesktop.Notifications',
            '/org/freedesktop/Notifications',
            'org.freedesktop.Notifications',
            None
        )
        proxy.call_sync(
            'Notify',
            GLib.Variant('(susssasa{sv}i)', (
                t('app_title'),       # app_name
                0,                    # replaces_id
                "screenshot",         # app_icon
                summary,              # summary
                body,                 # body
                [],                   # actions
                {},                   # hints
                3000                  # expire_timeout
            )),
            Gio.DBusCallFlags.NONE,
            -1,
            None
        )
    except Exception:
        if shutil.which("notify-send") is not None:
            subprocess.run(["notify-send", summary, body], stderr=subprocess.DEVNULL)

