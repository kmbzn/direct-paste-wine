def perform_first_time_setup():
    script_path = os.path.abspath(sys.argv[0])
    script_dir = os.path.dirname(script_path)
    
    icon_dest_dir = os.path.expanduser("~/.local/share/icons")
    os.makedirs(icon_dest_dir, exist_ok=True)
    icon_dest_path = os.path.join(icon_dest_dir, "direct-screenshot-logo.png")
    
    logo_src = os.path.join(script_dir, "logo.png")
    if os.path.exists(logo_src):
        try:
            shutil.copy2(logo_src, icon_dest_path)
            icon_path = icon_dest_path
        except Exception:
            icon_path = "screenshot"
    else:
        icon_path = "screenshot"

    desktop_dir = os.path.expanduser("~/.local/share/applications")
    os.makedirs(desktop_dir, exist_ok=True)
    desktop_path = os.path.join(desktop_dir, "direct-screenshot.desktop")
    
    desktop_content = f"""[Desktop Entry]
Name={t('app_title')}
Comment=Screenshot Utility with Clipboard and Save support
Exec={script_path}
Icon={icon_path}
Terminal=false
Type=Application
Categories=Utility;Graphics;
StartupNotify=false
"""
    try:
        with open(desktop_path, "w") as f:
            f.write(desktop_content)
        subprocess.run(["update-desktop-database", desktop_dir], stderr=subprocess.DEVNULL)
    except Exception as e:
        print(f"Failed to create desktop entry: {e}", file=sys.stderr)

