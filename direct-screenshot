                cb.append("window", t('opt_window'))
                cb.set_active_id(active_id)
                cb.set_hexpand(True)
                return cb

            def create_action_combobox(self, active_id):
                cb = Gtk.ComboBoxText()
                cb.append("both", t('opt_both'))
                cb.append("clipboard", t('opt_clipboard'))
                cb.append("save", t('opt_save'))
                cb.set_active_id(active_id)
                cb.set_hexpand(True)
                return cb

            def setup_dark_mode_sync(self):
                try:
                    self.settings = Gio.Settings.new("org.gnome.desktop.interface")
                    
                    def update_theme(*args):
                        is_dark = False
                        
                        # 1. Sync GSettings gtk-theme to GTK3 gtk-theme-name
                        try:
                            theme_name = self.settings.get_string("gtk-theme")
                            Gtk.Settings.get_default().set_property("gtk-theme-name", theme_name)
                            if "dark" in theme_name.lower():
                                is_dark = True
                        except Exception:
                            pass

                        # 2. Sync GSettings color-scheme
                        try:
                            color_scheme = self.settings.get_string("color-scheme")
                            if "prefer-dark" in color_scheme:
                                is_dark = True
                        except Exception:
                            pass
                            
                        # 3. Apply prefer dark theme property
                        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", is_dark)
                    
                    self.settings.connect("changed::gtk-theme", update_theme)
                    self.settings.connect("changed::color-scheme", update_theme)
                    update_theme()
                except Exception:
                    # Fallback to check GtkTheme name properties
                    try:
                        gtk_settings = Gtk.Settings.get_default()
                        theme_name = gtk_settings.get_property("gtk-theme-name").lower()
                        if "dark" in theme_name:
                            gtk_settings.set_property("gtk-application-prefer-dark-theme", True)
                    except Exception:
                        pass

            def on_capture_clicked(self, widget):
                mode = "screen"
                if self.rad_window.get_active():
                    mode = "window"
                elif self.rad_area.get_active():
                    mode = "area"
                    
                copy_clipboard = self.chk_clipboard.get_active()
                save_folder = self.chk_save.get_active()
                save_dir = self.folder_chooser.get_filename()

                # Save persistent configuration settings
                self.app_settings['clipboard_enabled'] = copy_clipboard
                self.app_settings['save_enabled'] = save_folder
                if save_dir:
                    self.app_settings['save_dir'] = save_dir
                save_settings(self.app_settings)

                self.hide()
                GLib.timeout_add(150, self.do_capture, mode, copy_clipboard, save_folder, save_dir)

            def do_capture(self, mode, copy_clipboard, save_folder, save_dir):
                temp_path = capture_screenshot(mode=mode)
                if not temp_path:
                    self.show_all()
                    return False

                process_screenshot_result_with_dir(temp_path, copy_clipboard, save_folder, save_dir)
                Gtk.main_quit()
                return False

            def on_apply_shortcuts_clicked(self, widget):
                dialog = Gtk.MessageDialog(
                    transient_for=self,
                    flags=0,
                    message_type=Gtk.MessageType.QUESTION,
                    buttons=Gtk.ButtonsType.YES_NO,
                    text=t('confirm_text')
                )
                response = dialog.run()
                dialog.destroy()

                if response != Gtk.ResponseType.YES:
                    return

                selections = {
                    'Print': (self.cb_mode_print.get_active_id(), self.cb_action_print.get_active_id()),
                    '<Ctrl>Print': (self.cb_mode_ctrl.get_active_id(), self.cb_action_ctrl.get_active_id()),
                    '<Shift>Print': (self.cb_mode_shift.get_active_id(), self.cb_action_shift.get_active_id()),
                    '<Alt>Print': (self.cb_mode_alt.get_active_id(), self.cb_action_alt.get_active_id())
                }

                script_path = os.path.abspath(sys.argv[0])
                schema = "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding"
                custom_base = "/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings"

                default_bindings = {
                    'Print': ('org.gnome.shell.keybindings', 'show-screenshot-ui'),
                    '<Ctrl>Print': ('org.gnome.shell.keybindings', 'screenshot'),
                    '<Shift>Print': ('org.gnome.shell.keybindings', 'screenshot-area'),
                    '<Alt>Print': ('org.gnome.shell.keybindings', 'screenshot-window')
                }

                try:
                    res = subprocess.run(
                        ['gsettings', 'get', 'org.gnome.settings-daemon.plugins.media-keys', 'custom-keybindings'],
                        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True
                    )
                    current_customs = res.stdout.strip()
                    
                    bindings_list = []
                    if current_customs and current_customs != "@as []":
                        bindings_list = current_customs.replace('[', '').replace(']', '').replace("'", "").split(', ')
                        bindings_list = [b for b in bindings_list if b]
                except Exception as e:
                    print(f"Failed to read custom shortcuts list: {e}", file=sys.stderr)
                    return

                for binding_key, (mode, action) in selections.items():
                    path_suffix = binding_key.lower().replace('<', '').replace('>', '')
                    base_path = f"{custom_base}/direct-paste-{path_suffix}/"
                    
                    g_schema, g_key = default_bindings[binding_key]
                    
                    if mode == 'disabled':
                        if base_path in bindings_list:
                            bindings_list.remove(base_path)
                        if gsettings_key_exists(g_schema, g_key):
                            subprocess.run(['gsettings', 'reset', g_schema, g_key], stderr=subprocess.DEVNULL)
                    else:
                        if base_path not in bindings_list:
                            bindings_list.append(base_path)
                        
                        cmd = script_path
                        if mode == 'screen':
                            cmd += " -s"
                        elif mode == 'window':
                            cmd += " -w"
                        else:
                            cmd += " -a"

                        if action == 'save':
                            cmd += " --no-clipboard"
                        elif action == 'clipboard':
                            cmd += " --no-save"

                        subprocess.run(['gsettings', 'set', f"{schema}:{base_path}", 'name', f"{t('custom_shortcut_name')} ({binding_key})"], stderr=subprocess.DEVNULL)
                        subprocess.run(['gsettings', 'set', f"{schema}:{base_path}", 'command', cmd], stderr=subprocess.DEVNULL)
                        subprocess.run(['gsettings', 'set', f"{schema}:{base_path}", 'binding', binding_key], stderr=subprocess.DEVNULL)

                        if gsettings_key_exists(g_schema, g_key):
                            subprocess.run(['gsettings', 'set', g_schema, g_key, '[]'], stderr=subprocess.DEVNULL)

                new_list = "[" + ", ".join([f"'{b}'" for b in bindings_list]) + "]"
                try:
                    subprocess.run(['gsettings', 'set', 'org.gnome.settings-daemon.plugins.media-keys', 'custom-keybindings', new_list], check=True)
                    send_notification(t('notification_applied_title'), t('notification_applied_body'))
                except Exception as e:
                    print(f"Failed to save custom keybindings list: {e}", file=sys.stderr)

        return _ScreenshotDialogInner(*args, **kwargs)

# ----------------------------------------------------------------------
# Result Processing Logic
# ----------------------------------------------------------------------

def process_screenshot_result_with_dir(temp_path, copy_clipboard, save_folder, save_dir, custom_dest_path=None):
    if not os.path.exists(temp_path):
        send_notification(t('error_file_title'), t('error_file_body'))
        return

    copied = False
    saved = False
    saved_path = ""

    if copy_clipboard:
        copied = inject_to_clipboard(temp_path)

    if save_folder or custom_dest_path:
        if custom_dest_path:
            dest_path = custom_dest_path
        else:
            os.makedirs(save_dir, exist_ok=True)
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            dest_path = os.path.join(save_dir, f"screenshot_{timestamp}.png")
        
        try:
            shutil.copy2(temp_path, dest_path)
            saved = True
            saved_path = dest_path
        except Exception as e:
            print(f"Failed to save screenshot file: {e}", file=sys.stderr)

    filename_base = os.path.basename(saved_path) if saved_path else ""

    if copied and saved:
        send_notification(
            t('notification_saved_copied_title'),
            t('notification_saved_copied_body').format(filename=filename_base)
        )
    elif copied:
        send_notification(t('notification_copied_title'), t('notification_copied_body'))
    elif saved:
        send_notification(
            t('notification_saved_title'),
            t('notification_saved_body').format(filename=filename_base)
        )
    else:
        send_notification(t('notification_complete_title'), t('notification_complete_body'))

# ----------------------------------------------------------------------
# Main Execution Entry Point
# ----------------------------------------------------------------------

def main():
    # 1. Enforce strict dependency validation in terminal on execution.
    # If gnome-screenshot or copyq is missing, fail immediately and instruct the user how to install.
    missing = []
    if not is_gnome_screenshot_installed():
        missing.append("gnome-screenshot")
    if not is_copyq_installed():
        missing.append("copyq")

    if missing:
        pkgs_str = " ".join(missing)
        err_msg_ko = f"\n[오류] 필수 시스템 패키지({', '.join(missing)})가 설치되어 있지 않습니다.\n설치 명령어: sudo apt-get install -y {pkgs_str}\n"
        err_msg_en = f"\n[Error] Required system packages ({', '.join(missing)}) are not installed.\nInstallation command: sudo apt-get install -y {pkgs_str}\n"
        
        err_msg = err_msg_ko if LANG == "ko" else err_msg_en
        print(err_msg, file=sys.stderr)
        sys.exit(1)

    # 2. Both dependencies are confirmed to be installed. Register desktop launcher.
    perform_first_time_setup()

    parser = argparse.ArgumentParser(
        description="Modern Screenshot Utility with CopyQ Multi-format support."
    )
    parser.add_argument(
        '-i', '--interactive', action='store_true',
        help="Run interactive GUI selector dialog"
    )
    parser.add_argument(
        '-a', '--area', action='store_true',
        help="Select a custom screen area to grab"
    )
    parser.add_argument(
        '-w', '--window', action='store_true',
        help="Select a window to grab"
    )
    parser.add_argument(
        '-s', '--screen', action='store_true',
        help="Grab the entire screen instantly"
    )
    parser.add_argument(
        '--no-clipboard', action='store_true',
        help="Do not copy screenshot to clipboard"
    )
    parser.add_argument(
        '--no-save', action='store_true',
        help="Do not save screenshot file to Screenshots folder"
    )
    parser.add_argument(
        '-f', '--file', type=str, default=None, metavar='PATH',
        help="Save screenshot directly to specified PATH"
    )

    args = parser.parse_args()

    # GUI Mode: Default execution if no capture mode flags are specified
    is_mode_specified = args.area or args.window or args.screen
    run_gui = args.interactive or not is_mode_specified

    if run_gui:
        global Gtk
        from gi.repository import Gtk
        dialog = ScreenshotDialog()
        Gtk.main()
    else:
        mode = "area"
        if args.window:
            mode = "window"
        elif args.screen:
            mode = "screen"
            
        copy_clipboard = not args.no_clipboard
        save_folder = not args.no_save if args.file is None else False

        # Load persisted settings for default folder path in CLI execution
        app_settings = load_settings()
        default_save_dir = app_settings.get('save_dir', os.path.expanduser("~/Pictures/Screenshots"))

        temp_path = capture_screenshot(mode=mode)
        if temp_path:
            process_screenshot_result_with_dir(
                temp_path,
                copy_clipboard=copy_clipboard,
                save_folder=save_folder,
                save_dir=default_save_dir,
                custom_dest_path=args.file
            )
            try:
                if os.path.exists(temp_path):
                    os.remove(temp_path)
            except Exception:
                pass
        else:
            print("Screenshot cancelled or failed.", file=sys.stderr)

if __name__ == "__main__":
    main()
